# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。RLSを越えて予約の排他制御・管理API処理を行うために使用する。クライアントには絶対に公開しない
SUPABASE_SERVICE_ROLE_KEY=

# LINEミニアプリ(LIFF)
NEXT_PUBLIC_LIFF_ID=

# LINE Messaging API（予約確定・リマインド通知の送信に使用）
LINE_CHANNEL_ACCESS_TOKEN=

# 前日リマインド送信API(/api/cron/reminder)を外部から叩けないようにするための合言葉
CRON_SECRET=

# マジックリンクのリダイレクト先を組み立てるために使用（本番ではデプロイ先のURL）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
